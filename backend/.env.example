# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- Core -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/paytm_ops

# --- Gemini agent layer (optional) ---------------------------------
# When unset, the Gemini agent path degrades gracefully; rules/ml/uplift
# policies are unaffected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_TURNS=4
GEMINI_TIMEOUT_SECONDS=20

# --- Recovery Scheduler (optional, OFF by default) ----------------
# In-process periodic auto-trigger: once per interval it asks the
# PortfolioAllocator for the top SCHEDULER_MAX_AUTO_RUNS_PER_CYCLE events and
# runs the existing agent-run path on each (tagged triggered_by="scheduler").
# No task queue. When SCHEDULER_ENABLED=false the timer never starts.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_MAX_AUTO_RUNS_PER_CYCLE=3
SCHEDULER_DRY_RUN=true
SCHEDULER_POLICY=rules
SCHEDULER_CYCLE_HISTORY_SIZE=20
# One bounded Gemini call per cycle (before the allocator) that can only reduce
# or skip this cycle's capacity, never raise it above
# SCHEDULER_MAX_AUTO_RUNS_PER_CYCLE. OFF by default; fails safe to full capacity.
SCHEDULER_AI_JUDGMENT_ENABLED=false

# --- Paytm integration (TEST MODE ONLY this stage) ----------------
# Test credentials for Paytm staging.
# The webhook secret is used to verify x-paytm-signature.
PAYTM_MID=TEST_MERCHANT_12345
PAYTM_MERCHANT_KEY=
PAYTM_WEBHOOK_SECRET=
PAYTM_BASE_URL=https://securegw-stage.paytm.in
PAYTM_TEST_MODE=true
PAYTM_TIMEOUT_SECONDS=15
PAYTM_PAYMENT_LINK_EXPIRY_MINUTES=60

# --- Hinglish voice / text-to-speech (DEMO SCOPE) ------------------
# Converts the agent's Hinglish customer_message into a real audio FILE,
# retrievable at GET /api/v1/voice/{audio_id}. It is NOT a phone call and
# reaches no customer through any channel. Off by default; failures fall back
# to text-only and never crash the recovery flow.
# NOTE: with the local pyttsx3 engine, audio is spoken by the installed OS
# voices only (en-US here) -- a real TTS file, not native Hindi pronunciation.
TTS_ENABLED=false
TTS_LANGUAGE=hi
TTS_OUTPUT_DIR=artifacts/tts
TTS_ENGINE=pyttsx3
